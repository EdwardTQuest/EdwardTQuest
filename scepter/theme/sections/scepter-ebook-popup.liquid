{%- comment -%}
  Scepter free e-book pop-up: name, email, and a choice of three interests (peace, prosperity,
  enlightenment), each with its own e-book. Add it once, to the footer group (Customize → Footer →
  Add section), so it can appear on every page. Any link to #free-ebook opens it.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign root = routes.root_url | append: '/' | replace: '//', '/'
-%}
{%- render 'scepter-head', load_fonts: s.load_fonts -%}
<div data-sp-popup="ebook" hidden>
  <script type="application/json" data-sp-config>
    {
      "sectionId": {{ section.id | json }},
      "enabled": {{ s.enabled | json }},
      "rootUrl": {{ root | json }},
      "triggers": { "delay": {{ s.delay | json }}, "scroll": {{ s.scroll | json }}, "exitIntent": {{ s.exit_intent | json }}, "hash": "free-ebook" },
      "suppressDays": {{ s.suppress_days | json }},
      "excludePaths": {{ s.exclude_paths | split: ',' | json }},
      "deliver": {{ s.deliver | json }},
      "style": {% capture sp_style %}{% render 'scepter-colors', s: s %}{% endcapture %}{{ sp_style | strip | json }},
      "copy": {
        "kicker": {{ s.kicker | json }}, "title": {{ s.heading | json }}, "sub": {{ s.subheading | json }},
        "legend": {{ s.legend | json }}, "button": {{ s.button | json }}, "doneTitle": {{ s.done_title | json }},
        "doneText": {{ s.done_text | json }}, "doneTextEmailOnly": {{ s.done_text_email | json }},
        "download": {{ s.download_label | json }}, "consent": {{ s.consent_text | json }}, "fine": {{ s.fine_print | json }}
      },
      "interests": [
        {%- for block in section.blocks -%}
          {"key": {{ block.settings.interest | json }}, "label": {{ block.settings.label | json }}, "blurb": {{ block.settings.blurb | json }}, "title": {{ block.settings.title | json }}, "author": {{ block.settings.author | json }}, "url": {{ block.settings.url | json }}, "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 360 | json }}{% else %}""{% endif %}},
        {%- endfor -%}
        null
      ],
      "lead": {% render 'scepter-lead-json', s: s %}
    }
  </script>
</div>
<script src="{{ 'scepter-lead.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'scepter-popups.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Scepter e-book pop-up",
  "tag": "div",
  "class": "scepter-ebook-popup-section",
  "limit": 1,
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the pop-up", "default": true },
    { "type": "paragraph", "content": "In the editor, click this section to open the pop-up. On the site, any link to #free-ebook opens it too." },
    { "type": "header", "content": "When it opens" },
    { "type": "range", "id": "delay", "label": "After this many seconds", "min": 0, "max": 90, "step": 5, "unit": "s", "default": 20, "info": "0 turns the timer off." },
    { "type": "range", "id": "scroll", "label": "Or after scrolling this far down a page", "min": 0, "max": 90, "step": 10, "unit": "%", "default": 50, "info": "0 turns it off." },
    { "type": "checkbox", "id": "exit_intent", "label": "Or when a desktop visitor moves to leave", "default": true },
    { "type": "range", "id": "suppress_days", "label": "After a visitor closes it, wait", "min": 1, "max": 90, "step": 1, "unit": "d", "default": 14 },
    { "type": "text", "id": "exclude_paths", "label": "Never on pages starting with", "default": "/cart, /checkout, /account, /pages/reading-plan", "info": "Comma-separated. It also stays away from any page with a quiz." },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "A gift for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose a free e-book" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Tell us what you’re hoping for, and we’ll send you a book to match." },
    { "type": "text", "id": "legend", "label": "Question", "default": "What are you hoping for most?" },
    { "type": "text", "id": "button", "label": "Button", "default": "Send me my free e-book" },
    { "type": "text", "id": "done_title", "label": "Thank-you heading", "default": "It’s yours{name}.", "info": "{name} becomes “, Joseph”." },
    { "type": "textarea", "id": "done_text", "label": "Thank-you text", "default": "Your e-book is ready to download. We’ve emailed you a copy too." },
    { "type": "textarea", "id": "done_text_email", "label": "Thank-you text (email delivery only)", "default": "Check your inbox: your e-book is on its way." },
    { "type": "text", "id": "download_label", "label": "Download button", "default": "Download the e-book" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "We’ll never share your email." },
    { "type": "select", "id": "deliver", "label": "Delivery", "default": "both", "options": [ { "value": "both", "label": "Download now and by email" }, { "value": "email", "label": "By email only" } ], "info": "Email delivery needs a Klaviyo flow or a webhook." },
    { "type": "header", "content": "Email" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo public API key" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID" },
    { "type": "text", "id": "klaviyo_event", "label": "Klaviyo event name", "default": "Requested Free E-book", "info": "Trigger the e-book delivery flow on this event; it carries the e-book link." },
    { "type": "url", "id": "webhook_url", "label": "Webhook URL" },
    { "type": "checkbox", "id": "shopify_customer", "label": "Add subscribers as Shopify customers", "default": true },
    { "type": "text", "id": "customer_tag", "label": "Customer tag", "default": "free-ebook" },
    { "type": "text", "id": "consent_text", "label": "Marketing checkbox text", "default": "Also send me occasional emails from Scepter. Unsubscribe anytime." },
    { "type": "checkbox", "id": "consent_checked", "label": "Marketing checkbox ticked by default", "default": true },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "color_forest", "label": "Dark green", "default": "#1f3d2e" },
    { "type": "color", "id": "color_sage", "label": "Light green", "default": "#d7e5d2" },
    { "type": "color", "id": "color_burgundy", "label": "Burgundy", "default": "#6f1d2c" },
    { "type": "color", "id": "color_cream", "label": "Cream", "default": "#fbf8f1" },
    { "type": "checkbox", "id": "load_fonts", "label": "Load the fonts", "default": true }
  ],
  "blocks": [
    {
      "type": "ebook",
      "name": "E-book",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "interest", "label": "Interest", "default": "peace", "options": [ { "value": "peace", "label": "Peace" }, { "value": "prosperity", "label": "Prosperity" }, { "value": "enlightenment", "label": "Enlightenment" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Peace" },
        { "type": "text", "id": "blurb", "label": "One line under the label", "info": "Shown when no e-book title is set." },
        { "type": "text", "id": "title", "label": "E-book title" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "image_picker", "id": "image", "label": "Cover" },
        { "type": "url", "id": "url", "label": "Download link", "info": "Upload the PDF or EPUB in Content → Files and paste its link." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Scepter e-book pop-up",
      "category": "Scepter",
      "blocks": [
        { "type": "ebook", "settings": { "interest": "peace", "label": "Peace", "blurb": "Rest for a restless heart" } },
        { "type": "ebook", "settings": { "interest": "prosperity", "label": "Prosperity", "blurb": "Work, family and a flourishing life" } },
        { "type": "ebook", "settings": { "interest": "enlightenment", "label": "Enlightenment", "blurb": "Light for the mind and the soul" } }
      ]
    }
  ]
}
{% endschema %}
