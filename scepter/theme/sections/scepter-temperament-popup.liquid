{%- comment -%}
  Scepter temperament test pop-up: the test, the reader's temperament (dominant and secondary),
  the virtue to grow, then Scepter's Alexandre Havard books to buy. Add it once, to the footer
  group (Customize → Footer → Add section). Any link to #temperament-test opens it, and an optional
  floating button offers it on every page.

  Questions are blocks (one per question). The preset's questions are a stand-in written for this
  kit; replace them with the official test (with HVLI's permission) here in the editor, or build a
  new preset from a spreadsheet: node scepter/tools/build-temperament-section.mjs questions.csv
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign root = routes.root_url | append: '/' | replace: '//', '/'
-%}
{%- render 'scepter-head', load_fonts: s.load_fonts -%}
<div data-sp-popup="temperament" hidden>
  <script type="application/json" data-sp-config>
    {
      "sectionId": {{ section.id | json }},
      "enabled": {{ s.enabled | json }},
      "rootUrl": {{ root | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "triggers": { "launcher": {{ s.launcher | json }}, "launcherPosition": {{ s.launcher_position | json }}, "delay": {{ s.delay | json }}, "exitIntent": {{ s.exit_intent | json }}, "hash": "temperament-test" },
      "suppressDays": {{ s.suppress_days | json }},
      "excludePaths": {{ s.exclude_paths | split: ',' | json }},
      "askEmail": {{ s.ask_email | json }},
      "maxBooks": {{ s.max_books | json }},
      "style": {% capture sp_style %}{% render 'scepter-colors', s: s %}{% endcapture %}{{ sp_style | strip | json }},
      "copy": {
        "kicker": {{ s.kicker | json }}, "title": {{ s.heading | json }}, "lead": {{ s.intro | json }}, "cta": {{ s.cta | json }},
        "meta": {{ s.meta | json }}, "attribution": {{ s.attribution | json }}, "attributionUrl": {{ s.attribution_url | json }},
        "booksTitle": {{ s.books_title | json }}, "booksLead": {{ s.books_lead | json }}, "forYou": {{ s.for_you_label | json }},
        "launcher": {{ s.launcher_label | json }}, "consent": {{ s.consent_text | json }}
      },
      "books": [
        {%- if s.book_all != blank -%}{"for": ["all"], "product": {% render 'scepter-product-json', product: s.book_all %}},{%- endif -%}
        {%- if s.book_choleric != blank -%}{"for": ["choleric"], "product": {% render 'scepter-product-json', product: s.book_choleric %}},{%- endif -%}
        {%- if s.book_melancholic != blank -%}{"for": ["melancholic"], "product": {% render 'scepter-product-json', product: s.book_melancholic %}},{%- endif -%}
        {%- if s.book_sanguine != blank -%}{"for": ["sanguine"], "product": {% render 'scepter-product-json', product: s.book_sanguine %}},{%- endif -%}
        {%- if s.book_phlegmatic != blank -%}{"for": ["phlegmatic"], "product": {% render 'scepter-product-json', product: s.book_phlegmatic %}},{%- endif -%}
        {%- if s.more_books != blank -%}{%- for p in s.more_books.products limit: 12 -%}{"for": [], "product": {% render 'scepter-product-json', product: p %}},{%- endfor -%}{%- endif -%}
        null
      ],
      "questions": [
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.prompt != blank -%}
            {"prompt": {{ block.settings.prompt | json }}, "weight": {{ block.settings.weight | json }}, "answers": [
              {"text": {{ block.settings.answer_1 | json }}, "score": {{ block.settings.score_1 | json }}},
              {"text": {{ block.settings.answer_2 | json }}, "score": {{ block.settings.score_2 | json }}},
              {"text": {{ block.settings.answer_3 | json }}, "score": {{ block.settings.score_3 | json }}},
              {"text": {{ block.settings.answer_4 | json }}, "score": {{ block.settings.score_4 | json }}}
            ]},
          {%- endif -%}
        {%- endfor -%}
        null
      ],
      "results": {
        {%- assign result_sep = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'result' -%}
            {{- result_sep -}}{{ block.settings.temperament | json }}: {"name": {{ block.settings.name | json }}, "tagline": {{ block.settings.tagline | json }}, "summary": {{ block.settings.summary | json }}, "strengths": {{ block.settings.strengths | json }}, "watch": {{ block.settings.watch | json }}, "virtue": {{ block.settings.virtue | json }}, "virtueText": {{ block.settings.virtue_text | json }}}
            {%- assign result_sep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "lead": {% render 'scepter-lead-json', s: s %}
    }
  </script>
</div>
<script src="{{ 'scepter-lead.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'scepter-temperament.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'scepter-popups.js' | asset_url }}" defer="defer"></script>

