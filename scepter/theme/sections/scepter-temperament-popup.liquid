              "value": "none",
              "label": "Nothing"
            }
          ]
        },
        {
          "type": "text",
          "id": "answer_2",
          "label": "Answer 2"
        },
        {
          "type": "select",
          "id": "score_2",
          "label": "Answer 2 counts for",
          "default": "melancholic",
          "options": [
            {
              "value": "choleric",
              "label": "Choleric"
            },
            {
              "value": "melancholic",
              "label": "Melancholic"
            },
            {
              "value": "sanguine",
              "label": "Sanguine"
            },
            {
              "value": "phlegmatic",
              "label": "Phlegmatic"
            },
            {
              "value": "none",
              "label": "Nothing"
            }
          ]
        },
        {
          "type": "text",
          "id": "answer_3",
          "label": "Answer 3"
        },
        {
          "type": "select",
          "id": "score_3",
          "label": "Answer 3 counts for",
          "default": "sanguine",
          "options": [
            {
              "value": "choleric",
              "label": "Choleric"
            },
            {
              "value": "melancholic",
              "label": "Melancholic"
            },
            {
              "value": "sanguine",
              "label": "Sanguine"
            },
            {
              "value": "phlegmatic",
              "label": "Phlegmatic"
            },
            {
