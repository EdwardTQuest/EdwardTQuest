  "max_blocks": 50,
  "presets": [
    {
      "name": "Scepter temperament test",
      "category": "Scepter",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "prompt": "Someone contradicts you in front of others. Your first reaction:",
            "weight": 1,
            "answer_1": "I push back right away. I won’t let it stand.",
            "score_1": "choleric",
            "answer_2": "I go quiet, but I’ll turn it over for days.",
            "score_2": "melancholic",
            "answer_3": "I laugh it off. By dinner it’s forgotten.",
            "score_3": "sanguine",
            "answer_4": "I stay calm and let it go. Not worth a fight.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "A free Saturday with nothing planned:",
            "weight": 1,
            "answer_1": "I call friends and see what happens.",
            "score_1": "sanguine",
            "answer_2": "Wonderful: a slow, quiet day at home.",
            "score_2": "phlegmatic",
            "answer_3": "I tackle the project I’ve been meaning to finish.",
            "score_3": "choleric",
            "answer_4": "A long walk, a good book, time to think.",
            "score_4": "melancholic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "A new project lands on your desk. You:",
            "weight": 1,
            "answer_1": "Take charge and set the goal.",
            "score_1": "choleric",
            "answer_2": "Think it through and plan every detail.",
            "score_2": "melancholic",
            "answer_3": "Get excited and share ideas with everyone.",
            "score_3": "sanguine",
            "answer_4": "Wait to see what’s needed, then do your part steadily.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "At a party where you know almost no one:",
            "weight": 1,
            "answer_1": "By the end of the night I know half the room.",
            "score_1": "sanguine",
            "answer_2": "I find the people worth talking to and get to it.",
            "score_2": "choleric",
            "answer_3": "I find one person and have a pleasant chat.",
            "score_3": "phlegmatic",
            "answer_4": "I’d rather be home; I stay near the edge.",
            "score_4": "melancholic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "When you make a mistake:",
            "weight": 1,
            "answer_1": "It stays with me for a long time.",
            "score_1": "melancholic",
            "answer_2": "I apologize, laugh, and move on.",
            "score_2": "sanguine",
            "answer_3": "I fix it fast and make sure it never happens again.",
            "score_3": "choleric",
            "answer_4": "I accept it calmly. These things happen.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "Your friends would say you are:",
            "weight": 1,
            "answer_1": "Determined and direct.",
            "score_1": "choleric",
            "answer_2": "Fun and full of life.",
            "score_2": "sanguine",
            "answer_3": "Easygoing and dependable.",
            "score_3": "phlegmatic",
            "answer_4": "Thoughtful and deep.",
            "score_4": "melancholic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "Plans change at the last minute:",
            "weight": 1,
            "answer_1": "Great, something new!",
            "score_1": "sanguine",
            "answer_2": "It unsettles me; I had it all worked out.",
            "score_2": "melancholic",
            "answer_3": "Annoying. I make a new plan on the spot.",
            "score_3": "choleric",
            "answer_4": "Fine by me. I adapt without fuss.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "In a disagreement, you tend to:",
            "weight": 1,
            "answer_1": "Argue until it’s settled.",
            "score_1": "choleric",
            "answer_2": "Look for a compromise so everyone is at peace.",
            "score_2": "phlegmatic",
            "answer_3": "Weigh every side, and often keep my view to myself.",
            "score_3": "melancholic",
            "answer_4": "Say what I think in the moment, then forget it.",
            "score_4": "sanguine"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "What drains you most?",
            "weight": 1,
            "answer_1": "Routine, and being alone too long.",
            "score_1": "sanguine",
            "answer_2": "Slowness and indecision in others.",
            "score_2": "choleric",
            "answer_3": "Noise, disorder and superficial talk.",
            "score_3": "melancholic",
            "answer_4": "Conflict and pressure.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "When someone hurts you:",
            "weight": 1,
            "answer_1": "I feel it deeply, and it takes a long time to heal.",
            "score_1": "melancholic",
            "answer_2": "I get angry quickly, and I don’t forget easily.",
            "score_2": "choleric",
            "answer_3": "I flare up, and then it’s over.",
            "score_3": "sanguine",
            "answer_4": "I hardly show it; it doesn’t shake me much.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "Deadlines:",
            "weight": 1,
            "answer_1": "I set them, for myself and for others.",
            "score_1": "choleric",
            "answer_2": "I meet them at my own steady pace.",
            "score_2": "phlegmatic",
            "answer_3": "I usually make them at the last minute.",
            "score_3": "sanguine",
            "answer_4": "I start early because I want it done perfectly.",
            "score_4": "melancholic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "When you walk into a room, people notice:",
            "weight": 1,
            "answer_1": "My energy and my laugh.",
            "score_1": "sanguine",
            "answer_2": "My confidence.",
            "score_2": "choleric",
            "answer_3": "Not much at first; I like to observe.",
            "score_3": "melancholic",
            "answer_4": "My calm.",
            "score_4": "phlegmatic"
          }
        },
        {
          "type": "question",
          "settings": {
            "prompt": "Your workspace is usually:",
            "weight": 1,
            "answer_1": "Organized, with everything in its place.",
